# Telegram Bot Configuration
# Bot token received from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram chat or channel ID (numeric, e.g. 123456789 or -100123456789)
TELEGRAM_CHAT_ID=

# Target Amoozeshyar bot username in iGap (default: amoozeshbot)
AMOOZESH_BOT_USERNAME=amoozeshbot

# Optional iGap WebSocket URL
IGAP_WS_URL=wss://secure.igap.net/hybrid/
